    expect(saved).toBeDefined();
    expect(saved?.title).toBe('Integration Task');
  });

  it('should throw ConflictException on OCC violation in DB', async () => {
    await prisma.task.create({
      data: {
        id: 'task-occ',
        title: 'DB Version',
        boardId: board.id,
        authorId: user.id,
        version: 10,
      },
